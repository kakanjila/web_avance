RewriteEngine On
RewriteBase /

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

RewriteRule ^$ frontoffice/index.php [L]

RewriteRule ^article/([a-zA-Z0-9_-]+)/?$ frontoffice/article.php?slug=$1 [L,QSA]

RewriteRule ^admin/?$ backoffice/login.php [L]
RewriteRule ^admin/dashboard/?$ backoffice/dashboard.php [L]
RewriteRule ^admin/articles/?$ backoffice/articles.php [L]
RewriteRule ^admin/article/add/?$ backoffice/article_form.php [L]
RewriteRule ^admin/article/edit/([0-9]+)/?$ backoffice/article_form.php?id=$1 [L,QSA]
RewriteRule ^admin/article/delete/([0-9]+)/?$ backoffice/article_delete.php?id=$1 [L,QSA]
RewriteRule ^admin/logout/?$ backoffice/logout.php [L]
